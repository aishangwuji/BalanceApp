{
  app: {
    // 签名配置不入库：每位开发者在本机用 DevEco Studio 的「Project Structure > Signing Configs」
    // 生成（会写回本文件的 signingConfigs 与 products[0].signingConfig）。
    // 公开仓库若包含本机证书路径与密码，等于泄露签名材料，因此默认留空。
    products: [
      {
        name: 'default',
        targetSdkVersion: '6.1.1(24)',
        compatibleSdkVersion: '6.1.1(24)',
        runtimeOS: 'HarmonyOS',
        buildOption: {
          strictMode: {
            caseSensitiveCheck: true,
            useNormalizedOHMUrl: true,
          },
        },
      },
    ],
    buildModeSet: [
      {
        name: 'debug',
      },
      {
        name: 'release',
      },
    ],
  },
  modules: [
    {
      name: 'entry',
      srcPath: './entry',
      targets: [
        {
          name: 'default',
          applyToProducts: [
            'default',
          ],
        },
      ],
    },
  ],
}
